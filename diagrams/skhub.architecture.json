    {
      "dot": "cyan",
      "title": "Core",
      "items": [
        "Nextcloud 31, pinned by SHA-256 digest, never a bare tag",
        "MariaDB and Redis behind it, with a nightly db-backup sidecar",
        "File storage decided once: shared NFS, external S3, or the fleet's own skstor"
      ]
    },
    {
      "dot": "emerald",
      "title": "Optional roles",
      "items": [
        "Talk HPB: Janus signaling plus eturnal STUN/TURN, TLS over 443 fallback",
        "Collabora Online for real-time collaborative documents",
        "Whiteboard, imaginary previews, notify_push, talk-recording"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "sksec edge: CrowdSec detection and a fail-closed Traefik bouncer",
        "SSO through user_oidc against sksso, with a break-glass local login",
        "ClamAV on every upload; deploys refuse silent mount drift"
      ]
    },
    {
      "dot": "amber",
      "title": "Agents and automation",
      "items": [
        "Hermes agents join rooms as a bot or as a real user account",
        "Dedicated webhook worker hands events to skflow in about 4 seconds",
        "Assistant runs on self-hosted models through skgateway; federation over OCM"
      ]
    }
